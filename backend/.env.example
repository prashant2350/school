APP_NAME=VidyaDesk API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./vidyadesk.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://vidyadesk:change-me@localhost:5432/vidyadesk
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
BOOTSTRAP_ADMIN_NAME=School Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# Set to false once you manage the database with Alembic (recommended for PostgreSQL / production)
AUTO_CREATE_TABLES=true

# AI answer keys + performance analysis (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

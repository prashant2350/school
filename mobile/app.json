{
  "expo": {
    "name": "St. Xavier's School",
    "slug": "xaviers-school-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.school.xaviers",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "in.school.xaviers",
      "supportsTablet": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
